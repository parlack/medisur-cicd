[Unit]
Description=Renew MediSur Kubernetes and Jenkins deployment credentials
Wants=network-online.target
After=network-online.target docker.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/sbin/medisur-renew-credentials
TimeoutStartSec=300
Restart=on-failure
RestartSec=60
UMask=0077
RuntimeDirectory=medisur-credentials
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StateDirectory=medisur-credentials
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE
ReadWritePaths=/etc/medisur/secrets/deployer-kubeconfig /etc/medisur/secrets/monitor-token /etc/medisur/secrets/monitor-ca.crt
