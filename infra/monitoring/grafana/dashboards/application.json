{
  "uid": "medisur-application",
  "title": "Medisur - Application",
  "tags": ["medisur", "application"],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": []},
  "annotations": {"list": []},
  "panels": [
    {
      "id": 1, "title": "Ready / desired replicas", "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "medisur-prometheus"},
      "fieldConfig": {"defaults": {"min": 0, "decimals": 0}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "kube_deployment_status_replicas_ready{namespace=\"medisur\",job=\"kube-state-metrics\"}", "legendFormat": "{{deployment}} ready"},
        {"refId": "B", "expr": "kube_deployment_spec_replicas{namespace=\"medisur\",job=\"kube-state-metrics\"}", "legendFormat": "{{deployment}} desired"}
      ]
    },
    {
      "id": 2, "title": "Pod version inventory", "type": "table",
      "description": "version comes from pod label app.kubernetes.io/version. unknown means missing metadata, not a verified app version. Value is scrape health, not readiness.",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "medisur-prometheus"},
      "targets": [{"refId": "A", "expr": "max by (namespace, pod, version) (up{job=\"medisur\"})", "instant": true, "format": "table"}]
    },
    {
      "id": 3, "title": "Application RPS by pod and version", "type": "timeseries",
      "description": "Excludes /metrics, /health and /ready. Rates are calculated per process before aggregation.",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "medisur-prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by (pod, version) (rate(http_requests_total{job=\"medisur\",route!~\"/metrics|/health|/ready\"}[$__rate_interval]))", "legendFormat": "{{pod}} / {{version}}"}]
    },
    {
      "id": 4, "title": "HTTP 5xx requests / second", "type": "timeseries",
      "description": "Zeros are shown only for pods with request series, never synthesized for missing scrape data.",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "medisur-prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by (pod, version) (rate(http_requests_total{job=\"medisur\",status=~\"5..\",route!~\"/metrics|/health|/ready\"}[$__rate_interval])) or on (pod, version) (0 * sum by (pod, version) (rate(http_requests_total{job=\"medisur\",route!~\"/metrics|/health|/ready\"}[$__rate_interval])))", "legendFormat": "{{pod}} / {{version}}"}]
    },
    {
      "id": 5, "title": "Histogram p95 request latency by version", "type": "timeseries",
      "description": "Aggregates buckets across pods by le and version BEFORE histogram_quantile. No traffic gives no percentile, not a fabricated zero.",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "medisur-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, version) (rate(http_request_duration_seconds_bucket{job=\"medisur\",route!~\"/metrics|/health|/ready\"}[$__rate_interval])))", "legendFormat": "{{version}} p95"}]
    },
    {
      "id": 6, "title": "Restarts / 10 minutes", "type": "timeseries",
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "medisur-prometheus"},
      "fieldConfig": {"defaults": {"min": 0}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"medisur\",job=\"kube-state-metrics\"}[10m]))", "legendFormat": "{{pod}}"}]
    },
    {
      "id": 7, "title": "Actual pod CPU usage (cores)", "type": "timeseries",
      "description": "Measured cAdvisor CPU, not requests/limits. Requires successful kubernetes-cadvisor scrape and node proxy authorization.",
      "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "medisur-prometheus"},
      "fieldConfig": {"defaults": {"unit": "cores", "min": 0}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{job=\"kubernetes-cadvisor\",namespace=\"medisur\",container!=\"\",container!=\"POD\",pod!=\"\"}[$__rate_interval]))", "legendFormat": "{{pod}}"}]
    },
    {
      "id": 8, "title": "Actual pod memory working set", "type": "timeseries",
      "description": "Measured cAdvisor working-set bytes. kube-state-metrics alone cannot provide this.",
      "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "medisur-prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by (namespace, pod) (container_memory_working_set_bytes{job=\"kubernetes-cadvisor\",namespace=\"medisur\",container!=\"\",container!=\"POD\",pod!=\"\"})", "legendFormat": "{{pod}}"}]
    },
    {
      "id": 9, "title": "Per-pod scrape health", "type": "timeseries",
      "gridPos": {"x": 0, "y": 32, "w": 24, "h": 6},
      "datasource": {"type": "prometheus", "uid": "medisur-prometheus"},
      "fieldConfig": {"defaults": {"min": 0, "max": 1}, "overrides": []},
      "targets": [{"refId": "A", "expr": "up{job=\"medisur\"}", "legendFormat": "{{pod}} / {{version}}"}]
    }
  ]
}