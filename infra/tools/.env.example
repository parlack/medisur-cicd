# Copy to .env on the tools VM only. No credentials belong in this file.
TOOLS_PRIVATE_IP=172.16.0.5
SECRETS_DIR=/etc/medisur/secrets
# Replace with: stat -c '%g' /var/run/docker.sock
DOCKER_GID=
JENKINS_ADMIN_ID=medisur-admin
JENKINS_URL=http://localhost:8080/
GRAFANA_ADMIN_USER=medisur-admin
# Must be within one minor release of the actual Kubernetes server version.
KUBECTL_VERSION=v1.34.3
KUBECTL_SHA256=ab60ca5f0fd60c1eb81b52909e67060e3ba0bd27e55a8ac147cbc2172ff14212